  typeface: [{"w":"p","ch":["이 문단에는 서체가 걸려 있지 않습니다. 페이지 기본인 산세리프로 보입니다."]},{"w":"p","ch":[{"w":"tf","a":{"v":"serif"},"ch":["이 문단은 세리프입니다. 고르는 것은 갈래이고, 실제 글꼴은 이 사이트가 토큰에 얹은 Noto Serif 입니다."]}]},{"w":"p","ch":[{"w":"tf","a":{"v":"mono"},"ch":["이 문단은 고정폭입니다. 글자 너비가 같아 자리를 세기 좋습니다 — 0O 1lI"]}]},{"w":"p","ch":[{"w":"tf","a":{"v":"cursive"},"ch":["이 문단은 필기체입니다. 손으로 쓴 얼굴이라 인용이나 덧말에 씁니다 — Handwriting · 手書き · 手写."]}]},{"w":"p","ch":["서체는 문단마다 다르게 걸립니다. 제목과 표는 산세리프, 코드는 고정폭으로 고정입니다. 아무것도 안 건 문단은 ",{"w":"b","ch":["wing 을 선언할 때 정한 기본값"]},"으로 보입니다 — 안 정하면 산세리프입니다."]}],
  dropcap: [{"w":"p","a":{"dc":1},"ch":["첫 글자가 세 줄을 감싸고 글은 그 옆으로 흐릅니다. 문단이 짧아도 감쌀 줄만큼 자리를 잡아 두므로 글자가 다음 블록으로 흘러내리지 않습니다."]},{"w":"p","ch":["이 문단에는 걸려 있지 않습니다."]}],
  clear_format: [{"w":"p","ch":[{"w":"b","ch":["굵게"]},"·",{"w":"i","ch":["기울임"]},"·",{"w":"u","ch":["밑줄"]},"·",{"w":"s","ch":["취소선"]},"이 걸린 글자를 골라 지우개를 눌러 보세요."]},{"w":"p","ch":["글자 서식만 지워지고 블록은 그대로 남습니다."]}],
  upload: [{"w":"p","ch":["파일을 이 상자에 끌어다 놓거나 붙여넣어 보세요. 이 사이트에는 올릴 서버가 없어 올리는 시늉만 하고, 결과는 이 페이지 안에서만 남습니다."]},{"w":"p","ch":["다 올라간 첨부는 ",{"w":"a","a":{"href":"https://nabi.saro.me/file-link-test.txt","file":"txt"},"ch":["첨부파일"]}," 처럼 남습니다."]}],
