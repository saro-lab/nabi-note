{
  "name": "nabi-web",
  "description": "NABI NOTE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 0.0.0.0",
    "build": "vitepress build docs",
    "typecheck": "tsc --noEmit",
    "pack:note": "node scripts/pack-note.mjs",
    "build:trees": "node ../nabi-npm/node_modules/tsx/dist/cli.mjs scripts/build-trees.ts",
    "check:frozen": "node ../nabi-npm/node_modules/tsx/dist/cli.mjs scripts/build-trees.ts --check",
    "build:full": "npm run pack:note && npm run build:trees && npm run build",
    "preview": "vitepress preview docs",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "minisearch": "^7.2.0",
    "nabi-note": "file:nabi-note-1.3.0.tgz",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.20",
    "vue": "^3.5.43",
    "wrangler": "^4.147.0"
  }
}
