{
  "name": "nabi-note",
  "version": "1.2.0",
  "description": "open-source WYSIWYG editor",
  "keywords": [
    "wysiwyg",
    "editor",
    "dom-free",
    "ssr",
    "xss",
    "upload",
    "file-upload"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "default": "./dist/ssr.js"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "default": "./dist/viewer/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./nabi.css": "./dist/nabi.css",
    "./package.json": "./package.json",
    "./icons/*": "./dist/icons/*"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "unpkg": "./dist/browser/nabi-note.min.js",
  "jsdelivr": "./dist/browser/nabi-note.min.js",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "safari >= 17",
    "not dead"
  ],
  "scripts": {
    "demo": "vite demo --open --host 0.0.0.0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test scripts '*.mjs' '*.json'",
    "format:check": "prettier --check src test scripts '*.mjs' '*.json'",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --all --include='src/**/*.ts' --exclude='src/**/*.d.ts' --check-coverage --lines 80 --functions 75 --branches 70 --statements 80 node scripts/run-tests.mjs",
    "test:browser": "playwright test",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup && node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-css.mjs && npm run build:cdn",
    "build:cdn": "node --import tsx scripts/build-cdn.mjs",
    "version": "node scripts/sync-version.mjs && git add src/io/file.ts",
    "cdn": "vite cdn/dist --open",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
